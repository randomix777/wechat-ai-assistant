# PyInstaller scratch and the built bundle. The build is reproducible from
# deploy/merchant.spec, so neither belongs in version control.
build/
dist/
*.manifest

# Generated by examples/smoke_gateway.py at run time.
.smoke-model-policy.json

# Local secrets. Point PYWEIXIN_OPENCODE_PASSWORD_FILE at one of these instead of
# putting the key in an env var (which ends up in deploy logs) or on the
# command line (which ends up in `ps` output).
*.pw
secrets.local.json
gateway.local.env

# Private OpenCode instance prepared by
# examples/prepare_isolated_opencode.py: its own config, data, cache, logs,
# generated server password and the upstream credentials the user logs into
# there. Nothing in here belongs in version control.
.opencode-private/

# Release bundles and the checksums/tool caches that sit next to them. The
# build is reproducible from deploy/merchant.spec, so the artifacts do not
# belong in version control either — the same rule as build/ and dist/.
微信AI智能助理-win64-*.zip
微信AI智能助理-win64-*.zip.sha256
微信AI智能助理-win64-*/
.wrangler/
.commandcode/
